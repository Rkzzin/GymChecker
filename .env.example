# Supabase — cliente público (browser), protegido por RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role, usado SÓ nas rotas server-side em src/app/api/
# NUNCA prefixar com NEXT_PUBLIC_ (viraria exposto ao browser)
SUPABASE_SERVICE_ROLE_KEY=

# Token Bearer exigido por POST /api/check-access.
# Obrigatório em produção — se ausente, a rota agora recusa todas as
# requisições (fail closed). Ver docs/05-divergences-and-risks.md.
API_SECRET_TOKEN=
